<?xml version="1.0" encoding="utf-8"?>
<!-- The map of all screens. Home is where the app starts.
     The four TAB screens (home, discover, collection, profile) get their ids from res/menu/bottom_nav.xml
     and from TAB_SCREEN_IDS in MainActivity. Every other screen hides the tab bar. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- ===== The four tabs ===== -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.cinefiles.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <!-- Search, Popular / Trending / Top rated and the genre chips, as a poster grid. -->
    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.example.cinefiles.ui.discover.DiscoverFragment"
        android:label="@string/nav_discover"
        tools:layout="@layout/fragment_discover" />

    <!-- Your Liked movies, your Watchlist and the movies you Watched. -->
    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.example.cinefiles.ui.collection.CollectionFragment"
        android:label="@string/nav_collection"
        tools:layout="@layout/fragment_collection" />

    <!-- Your name, your taste, your achievements, About and Clear my data. -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.cinefiles.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ===== The "watch something" flow: Home -> Mood -> Preferences -> Swipe -> Your Picks =====
         They share one WatchFlowViewModel. -->

    <fragment
        android:id="@+id/moodFragment"
        android:name="com.example.cinefiles.ui.mood.MoodFragment"
        android:label="@string/mood_title"
        tools:layout="@layout/fragment_mood" />

    <fragment
        android:id="@+id/preferencesFragment"
        android:name="com.example.cinefiles.ui.mood.PreferencesFragment"
        android:label="@string/pref_title"
        tools:layout="@layout/fragment_preferences" />

    <fragment
        android:id="@+id/swipeFragment"
        android:name="com.example.cinefiles.ui.swipe.SwipeFragment"
        android:label="@string/swipe_progress"
        tools:layout="@layout/fragment_swipe" />

    <!-- Opens from the "Picks (n)" pill, from "Show my picks" at the end of the deck and from "Show picks anyway". -->
    <fragment
        android:id="@+id/picksFragment"
        android:name="com.example.cinefiles.ui.picks.PicksFragment"
        android:label="@string/picks_title"
        tools:layout="@layout/fragment_picks" />

    <!-- ===== Movie Details =====
         It opens with openMovieDetails(movieId) from Home, Discover, the swipe cards, My Collection, Your Picks and
         the "Similar movies" row. The argument key must match ARG_MOVIE_ID in NavigationExtensions.kt. -->
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.cinefiles.ui.detail.DetailFragment"
        android:label="@string/detail_label"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="movieId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <!-- ===== Person: an actor, a director or another crew member, with their movies =====
         It opens with openPerson(personId) from the cast and crew of Movie Details. The argument key must match
         ARG_PERSON_ID in NavigationExtensions.kt. -->
    <fragment
        android:id="@+id/personFragment"
        android:name="com.example.cinefiles.ui.person.PersonFragment"
        android:label="@string/person_label"
        tools:layout="@layout/fragment_person">
        <argument
            android:name="personId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <!-- ===== Movie Diary =====
         The list opens from the Profile ("Movie Diary", every page) and from Details ("Open Diary", the pages of one movie).
         The editor opens from a page in the list, and from Details ("Write in Diary") for a new page. The argument keys
         must match ARG_MOVIE_ID and ARG_DIARY_ENTRY_ID in NavigationExtensions.kt. -->
    <fragment
        android:id="@+id/diaryListFragment"
        android:name="com.example.cinefiles.ui.diary.DiaryListFragment"
        android:label="@string/diary_list_title"
        tools:layout="@layout/fragment_diary_list">
        <argument
            android:name="movieId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/diaryEditorFragment"
        android:name="com.example.cinefiles.ui.diary.DiaryEditorFragment"
        android:label="@string/diary_editor_title"
        tools:layout="@layout/fragment_diary_editor">
        <argument
            android:name="entryId"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="movieId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

</navigation>

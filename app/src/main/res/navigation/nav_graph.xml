<?xml version="1.0" encoding="utf-8"?>
<!-- The map of all screens. Home is where the app starts.
     The four TAB screens (home, discover, collection, profile) get their ids from res/menu/bottom_nav.xml. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- ===== Real screens ===== -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.cinefiles.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <!-- Profile (a tab): your numbers and your achievements. It has a TEMP button that opens the
         Batch 1 design gallery, so the gallery stays reachable. -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.cinefiles.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- The "watch something" flow. Home -> Mood -> Preferences -> Swipe (Batch 4).
         All of them share one WatchFlowViewModel. The bottom bar is hidden on all of them. -->
    <fragment
        android:id="@+id/moodFragment"
        android:name="com.example.cinefiles.ui.mood.MoodFragment"
        android:label="@string/mood_title"
        tools:layout="@layout/fragment_mood" />

    <fragment
        android:id="@+id/preferencesFragment"
        android:name="com.example.cinefiles.ui.mood.PreferencesFragment"
        android:label="@string/pref_title"
        tools:layout="@layout/fragment_preferences" />

    <fragment
        android:id="@+id/swipeFragment"
        android:name="com.example.cinefiles.ui.swipe.SwipeFragment"
        android:label="@string/swipe_progress"
        tools:layout="@layout/fragment_swipe" />

    <!-- ===== TEMP: stand-in screens. Each one is replaced by its real screen in a later batch:
         change android:name to the new Fragment and delete the arguments. See TEMP.md. ===== -->

    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.example.cinefiles.ui.temp.TempScreenFragment"
        android:label="@string/nav_discover"
        tools:layout="@layout/fragment_temp_screen">
        <argument
            android:name="title"
            android:defaultValue="@string/nav_discover"
            app:argType="reference" />
        <argument
            android:name="message"
            android:defaultValue="@string/temp_discover_message"
            app:argType="reference" />
    </fragment>

    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.example.cinefiles.ui.temp.TempScreenFragment"
        android:label="@string/nav_collection"
        tools:layout="@layout/fragment_temp_screen">
        <argument
            android:name="title"
            android:defaultValue="@string/nav_collection"
            app:argType="reference" />
        <argument
            android:name="message"
            android:defaultValue="@string/temp_collection_message"
            app:argType="reference" />
    </fragment>

    <!-- (Profile used to be a stand-in here. It is a real screen now: see below, next to Home.) -->

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.cinefiles.ui.temp.TempScreenFragment"
        android:label="@string/temp_details_title"
        tools:layout="@layout/fragment_temp_screen">
        <argument
            android:name="title"
            android:defaultValue="@string/temp_details_title"
            app:argType="reference" />
        <argument
            android:name="message"
            android:defaultValue="@string/temp_details_message"
            app:argType="reference" />
        <argument
            android:name="showBack"
            android:defaultValue="true"
            app:argType="boolean" />
        <!-- The id of the movie to show. The key must match ARG_MOVIE_ID in NavigationExtensions.kt -->
        <argument
            android:name="movieId"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <!-- TEMP: stand-in for Your Picks (the real screen is Batch 7). It opens from the "Picks (n)" pill and
         from "Show my picks" on the swipe screen. -->
    <fragment
        android:id="@+id/picksFragment"
        android:name="com.example.cinefiles.ui.temp.TempScreenFragment"
        android:label="@string/temp_picks_title"
        tools:layout="@layout/fragment_temp_screen">
        <argument
            android:name="title"
            android:defaultValue="@string/temp_picks_title"
            app:argType="reference" />
        <argument
            android:name="message"
            android:defaultValue="@string/temp_picks_message"
            app:argType="reference" />
        <argument
            android:name="showBack"
            android:defaultValue="true"
            app:argType="boolean" />
    </fragment>

    <!-- TEMP: the Batch 1 design gallery. Reachable from the Profile screen. Removed in Batch 8. -->
    <fragment
        android:id="@+id/designGalleryFragment"
        android:name="com.example.cinefiles.ui.gallery.DesignGalleryFragment"
        android:label="@string/gallery_title"
        tools:layout="@layout/fragment_design_gallery" />

</navigation>

<?xml version="1.0" encoding="utf-8"?>
<!-- PREFERENCES: "Make it yours". Step 2 of 3. Everything is optional and starts at "Any".
     Top bar (back, step indicator, Skip) and footer (Start swiping) are FIXED; the chips scroll. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/prefsTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <ImageButton
            android:id="@+id/prefsBack"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <com.example.cinefiles.ui.components.StepIndicatorView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:currentStep="2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prefsSkip"
            style="@style/Widget.CineFiles.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="@string/pref_skip" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_title"
                android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/pref_hint"
                android:textAppearance="@style/TextAppearance.CineFiles.Callout" />

            <!-- One chip group per question. The chips are added from code. Exactly one chip is always selected. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:text="@string/pref_section_period"
                android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/periodChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:chipSpacingVertical="@dimen/space_8"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/pref_section_rating"
                android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/ratingChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:chipSpacingVertical="@dimen/space_8"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/pref_section_length"
                android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/lengthChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:chipSpacingVertical="@dimen/space_8"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/pref_section_language"
                android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/languageChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:chipSpacingHorizontal="@dimen/space_8"
                app:chipSpacingVertical="@dimen/space_8"
                app:selectionRequired="true"
                app:singleSelection="true" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/prefsFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startSwipingButton"
            style="@style/Widget.CineFiles.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pref_start" />

    </LinearLayout>
</LinearLayout>

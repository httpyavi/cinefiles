<?xml version="1.0" encoding="utf-8"?>
<!-- PREFERENCES: "Make it yours". Step 2 of 3.
     Redesigned as a cinematic personalization experience with distinct,
     interactive era, rating, runtime, and language cards. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.cinefiles.ui.components.AmbientGlowView
        android:id="@+id/prefsGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar: Back, Step Indicator, Skip -->
        <FrameLayout
            android:id="@+id/prefsTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_8">

            <ImageButton
                android:id="@+id/prefsBack"
                android:layout_width="@dimen/round_button_small_size"
                android:layout_height="@dimen/round_button_small_size"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/action_back"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <com.example.cinefiles.ui.components.StepIndicatorView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:currentStep="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/prefsSkip"
                style="@style/Widget.CineFiles.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:text="@string/pref_skip"
                android:textColor="@color/accent_soft" />

        </FrameLayout>

        <!-- Scrollable content -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_24">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="STEP 2 OF 3"
                    android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                    android:textColor="@color/accent_soft" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:accessibilityHeading="true"
                    android:text="@string/pref_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle"
                    tools:targetApi="28" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/pref_subtitle"
                    android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pref_hint"
                    android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                    android:textColor="@color/text_secondary" />

                <!-- ============================================== -->
                <!-- A. RELEASE PERIOD (Cinematic Era)               -->
                <!-- ============================================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_film"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/pref_section_period"
                            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="28dp"
                        android:text="@string/pref_section_period_sub"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                        android:textColor="@color/text_secondary" />

                    <!-- 2x2 Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/periodAny"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_period_any_era" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/periodBefore2000"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_period_classic" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/period2000To2014"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_period_modern" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/periodFrom2015"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_period_recent" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============================================== -->
                <!-- B. MINIMUM RATING (Star Threshold)             -->
                <!-- ============================================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_filled"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/pref_section_rating"
                            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="28dp"
                        android:text="@string/pref_section_rating_sub"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                        android:textColor="@color/text_secondary" />

                    <!-- Horizontal Row of 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/ratingAny"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_any" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rating6"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="★ 6+" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rating7"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="★ 7+" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rating8"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="★ 8+" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============================================== -->
                <!-- C. LENGTH (Runtime Duration)                   -->
                <!-- ============================================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/pref_section_length"
                            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="28dp"
                        android:text="@string/pref_section_length_sub"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                        android:textColor="@color/text_secondary" />

                    <!-- 2x2 Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lengthAny"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_length_any" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lengthUnder90"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_length_quick" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lengthUnder2h"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_length_standard" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lengthOver2h"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_length_epic" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============================================== -->
                <!-- D. LANGUAGE (Balanced arrangement)              -->
                <!-- ============================================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_globe"
                            app:tint="@color/accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="@string/pref_section_language"
                            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="28dp"
                        android:text="@string/pref_section_language_sub"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                        android:textColor="@color/text_secondary" />

                    <!-- Balanced 1 + 2 + 2 layout -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/languageAny"
                        style="@style/Widget.CineFiles.Button.PreferenceCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/pref_language_any" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/languageEnglish"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_language_english" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/languageFilipino"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_language_filipino" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/languageKorean"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_language_korean" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/languageJapanese"
                            style="@style/Widget.CineFiles.Button.PreferenceCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:text="@string/pref_language_japanese" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Footer: Redesigned Primary CTA "Start Swiping" -->
        <LinearLayout
            android:id="@+id/prefsFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_12"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_16">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startSwipingButton"
                style="@style/Widget.CineFiles.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/pref_start"
                android:textAppearance="@style/TextAppearance.CineFiles.Button"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="@dimen/space_8"
                app:iconTint="@color/text_primary" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>

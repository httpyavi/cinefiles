<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:layout_height="@dimen/diary_cover_height"
    android:layout_marginEnd="@dimen/space_12">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/attachmentImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:contentDescription="@string/diary_cover_description"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.CineFiles.Small" />

    <ImageButton
        android:id="@+id/attachmentRemove"
        style="@style/Widget.CineFiles.ImageTool"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_8"
        android:background="@drawable/bg_image_tools"
        android:contentDescription="@string/diary_cover_remove"
        android:padding="@dimen/space_4"
        android:src="@drawable/ic_delete" />
</FrameLayout>

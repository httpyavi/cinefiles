<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        android:id="@+id/dialogRateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/detail_rate_movie"
        android:textAppearance="@style/TextAppearance.CineFiles.Title" />

    <TextView
        android:id="@+id/dialogRatingValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle"
        android:textColor="@color/accent"
        tools:text="4.5 ★" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:text="0.5 to 5.0 stars (half-star increments)"
        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

    <!-- 5 Star Buttons in a row -->
    <LinearLayout
        android:id="@+id/starsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/star1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/accent" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/accent" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/accent" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/accent" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="6dp"
            android:src="@drawable/ic_star_filled"
            app:tint="@color/accent" />
    </LinearLayout>

    <!-- Quick half-star fine-tuning pills -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMinusHalf"
            style="@style/Widget.CineFiles.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="− 0.5" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlusHalf"
            style="@style/Widget.CineFiles.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="+ 0.5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoveRating"
            style="@style/Widget.CineFiles.Button.Text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/detail_remove_rating"
            android:textColor="@color/accent_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRating"
            style="@style/Widget.CineFiles.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:text="Done" />
    </LinearLayout>

</LinearLayout>

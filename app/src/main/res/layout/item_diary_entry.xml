<?xml version="1.0" encoding="utf-8"?>
<!-- One diary page in the list (DiaryEntryAdapter): a card in the page's own theme (the colors are set from code), with the
     small poster, the movie (a link to its Details), the date, the rating the page was written with, the headline and the first words in the
     page's own font. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/entryCard"
    style="@style/Widget.CineFiles.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_large"
    app:strokeColor="@color/glass_stroke"
    app:strokeWidth="@dimen/glass_stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_12">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/entryPoster"
            android:layout_width="@dimen/diary_cover_width"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@color/surface"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.CineFiles.Small" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/entryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                tools:text="Interstellar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/entryDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                    tools:text="Nov 25, 2026" />

                <com.example.cinefiles.ui.components.PopcornRatingView
                    android:id="@+id/entryRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:visibility="gone"
                    app:interactive="false"
                    app:popcornGap="@dimen/popcorn_gap_small"
                    app:popcornSize="@dimen/popcorn_size_small"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/entryHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:ellipsize="end"
                android:maxLines="2"
                android:visibility="gone"
                tools:text="A film about trust"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/entryPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.CineFiles.Body"
                tools:text="I did not expect to cry at a space movie. The docking scene took my breath away." />
        </LinearLayout>

        <ImageButton
            android:id="@+id/entryDelete"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/diary_delete"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

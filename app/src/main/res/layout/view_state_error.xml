<?xml version="1.0" encoding="utf-8"?>
<!-- ERROR state: message + Retry button.
     A screen can change the texts from code and sets what Retry does:
       errorRetry.setOnClickListener { viewModel.reload() } -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_24"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_24">

    <ImageView
        android:layout_width="@dimen/end_icon_plate_size"
        android:layout_height="@dimen/end_icon_plate_size"
        android:background="@drawable/bg_glass_circle"
        android:importantForAccessibility="no"
        android:padding="@dimen/space_20"
        android:src="@drawable/ic_info"
        app:tint="@color/accent_soft" />

    <TextView
        android:id="@+id/errorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center"
        android:text="@string/error_unknown_title"
        android:textAppearance="@style/TextAppearance.CineFiles.Title" />

    <TextView
        android:id="@+id/errorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:maxWidth="@dimen/state_text_max_width"
        android:text="@string/error_unknown_message"
        android:textAppearance="@style/TextAppearance.CineFiles.Callout" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/errorRetry"
        style="@style/Widget.CineFiles.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/state_retry" />

</LinearLayout>

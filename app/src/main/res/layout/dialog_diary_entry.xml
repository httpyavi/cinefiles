<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <TextView
            android:id="@+id/diaryDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diary_title"
            android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle" />

        <TextView
            android:id="@+id/diaryMovieSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.CineFiles.Callout"
            tools:text="Interstellar (2014)" />

        <!-- Rating Section in Diary -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/detail_personal_rating"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <TextView
            android:id="@+id/diaryRatingDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="Tap stars below to rate"
            android:textAppearance="@style/TextAppearance.CineFiles.Label"
            android:textColor="@color/accent" />

        <LinearLayout
            android:id="@+id/diaryStarsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/diaryStar1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/accent" />

            <ImageView
                android:id="@+id/diaryStar2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/accent" />

            <ImageView
                android:id="@+id/diaryStar3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/accent" />

            <ImageView
                android:id="@+id/diaryStar4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/accent" />

            <ImageView
                android:id="@+id/diaryStar5"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="4dp"
                android:src="@drawable/ic_star_filled"
                app:tint="@color/accent" />
        </LinearLayout>

        <!-- Rewatch check -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/diaryRewatchCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/diary_rewatch"
            android:textAppearance="@style/TextAppearance.CineFiles.Body" />

        <!-- Thoughts / Review -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="Your Review / Notes"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <EditText
            android:id="@+id/diaryNotesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_glass_pill"
            android:gravity="top|start"
            android:hint="@string/diary_thoughts_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4"
            android:padding="@dimen/space_16"
            android:textAppearance="@style/TextAppearance.CineFiles.Body"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diaryBtnCancel"
                style="@style/Widget.CineFiles.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_close" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/diaryBtnSave"
                style="@style/Widget.CineFiles.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:text="@string/diary_save" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

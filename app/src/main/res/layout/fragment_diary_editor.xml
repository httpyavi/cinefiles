<?xml version="1.0" encoding="utf-8"?>
<!-- THE DIARY EDITOR (DiaryEditorFragment): one page written like a post on Substack. No boxes and no cells: the movie's name (a link to its
     Details), the date and the rating, an optional headline, an optional cover picture, then ONE continuous body that fills the page.
     A top bar (back, Style, Save) and a formatting strip that shows while the body or the headline is being written (bold, italic, underline,
     heading, pull-quote and the four alignments). The page's background, text colors, font and size come from its look (set from code).
     There is no tab bar on this screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- ===== Top bar ===== -->
    <LinearLayout
        android:id="@+id/editorTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_8">

        <ImageButton
            android:id="@+id/editorBack"
            android:layout_width="@dimen/round_button_small_size"
            android:layout_height="@dimen/round_button_small_size"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/editorStyle"
            android:layout_width="@dimen/round_button_small_size"
            android:layout_height="@dimen/round_button_small_size"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="@string/diary_style"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_palette"
            app:tint="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editorSave"
            style="@style/Widget.CineFiles.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/diary_save" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/editorImporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/glass_fill" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== The page ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/editorScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_24"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/space_24"
                android:paddingBottom="@dimen/space_32">

                <!-- The movie: a link to its Details, with the date and the rating the page was written with -->
                <LinearLayout
                    android:id="@+id/movieLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_4">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/moviePoster"
                        android:layout_width="@dimen/diary_poster_thumb_width"
                        android:layout_height="@dimen/diary_poster_thumb_height"
                        android:background="@color/surface"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.CineFiles.Small" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/movieTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="@dimen/space_4"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                            app:drawableEndCompat="@drawable/ic_chevron_right"
                            tools:text="Emergency Declaration" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/pageDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                                tools:text="Nov 25, 2026" />

                            <com.example.cinefiles.ui.components.PopcornRatingView
                                android:id="@+id/pageRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_12"
                                android:visibility="gone"
                                app:interactive="false"
                                app:popcornGap="@dimen/popcorn_gap_small"
                                app:popcornSize="@dimen/popcorn_size_diary_header"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Document content: interleaved text blocks and inline photos -->
                <LinearLayout
                    android:id="@+id/documentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:minHeight="@dimen/diary_body_min_height"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/editorStates"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <include
                android:id="@+id/stateLoading"
                layout="@layout/view_state_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/stateMissing"
                layout="@layout/view_state_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- ===== Formatting strip: while the page is being written ===== -->
    <HorizontalScrollView
        android:id="@+id/formatBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/glass_dark"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_8">

            <TextView
                android:id="@+id/formatBold"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_format_bold"
                android:text="@string/diary_format_bold_letter"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/formatItalic"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_format_italic"
                android:text="@string/diary_format_italic_letter"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/formatUnderline"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_format_underline"
                android:text="@string/diary_format_underline_letter" />

            <TextView
                android:id="@+id/formatHeading"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_format_heading"
                android:text="@string/diary_format_heading_letter"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/formatQuote"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_format_quote"
                android:src="@drawable/ic_quote" />

            <View
                android:layout_width="@dimen/glass_stroke_width"
                android:layout_height="@dimen/icon_size"
                android:layout_marginStart="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_8"
                android:background="@color/glass_stroke"
                android:importantForAccessibility="no" />

            <ImageButton
                android:id="@+id/alignLeft"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_align_left"
                android:src="@drawable/ic_align_left" />

            <ImageButton
                android:id="@+id/alignCenter"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_align_center"
                android:src="@drawable/ic_align_center" />

            <ImageButton
                android:id="@+id/alignRight"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_align_right"
                android:src="@drawable/ic_align_right" />

            <View
                android:layout_width="@dimen/glass_stroke_width"
                android:layout_height="@dimen/icon_size"
                android:layout_marginStart="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_8"
                android:background="@color/glass_stroke"
                android:importantForAccessibility="no" />

            <ImageButton
                android:id="@+id/formatPhoto"
                style="@style/Widget.CineFiles.FormatButton"
                android:contentDescription="@string/diary_cover_add"
                android:src="@drawable/ic_image" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- SWIPE. Top to bottom: the top bar (close, progress + moods, Picks pill, thin progress bar),
     the pile of cards (all the remaining height), and the four round buttons.
     It never scrolls, so it fits a small phone. No bottom tab bar on this screen.

     clipChildren="false" on every parent of the cards: they fly out past the edges and cast a shadow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- ===== Top bar ===== -->
    <LinearLayout
        android:id="@+id/swipeTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/swipeClose"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:src="@drawable/ic_close"
                app:tint="@color/text_primary" />

            <!-- "7 of 20" and the chosen moods. Long-press the moods line to test loading / error / empty (TEMP). -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_marginEnd="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/swipeProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CineFiles.Label"
                    tools:text="7 of 20" />

                <TextView
                    android:id="@+id/swipeCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                    tools:text="Happy · Romantic" />

            </LinearLayout>

            <!-- Appears after the first like. It takes you to Your Picks. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/swipePicksPill"
                style="@style/Widget.CineFiles.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/chip_height"
                android:paddingStart="@dimen/space_16"
                android:paddingEnd="@dimen/space_16"
                android:textAppearance="@style/TextAppearance.CineFiles.Label"
                android:visibility="invisible"
                tools:text="Picks (3)"
                tools:visibility="visible" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/swipeProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginTop="@dimen/space_8"
            app:indicatorColor="@color/text_primary"
            app:trackColor="@color/elevated"
            app:trackCornerRadius="@dimen/radius_pill"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="@dimen/swipe_progress_height"
            tools:progress="35" />

    </LinearLayout>

    <!-- ===== Everything below the top bar. The error / empty states cover all of it. ===== -->
    <FrameLayout
        android:id="@+id/swipeBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/swipeColumn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- The pile of cards -->
            <FrameLayout
                android:id="@+id/swipeDeckArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginBottom="@dimen/space_24"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.example.cinefiles.ui.swipe.SwipeDeckView
                    android:id="@+id/swipeDeck"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- LOADING: one quiet, empty card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/swipeLoading"
                    style="@style/Widget.CineFiles.Card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/state_loading"
                    android:importantForAccessibility="yes"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/radius_xlarge" />

                <!-- END OF THE DECK -->
                <include
                    android:id="@+id/swipeEnd"
                    layout="@layout/view_swipe_end"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- Undo, Pass, Like, Info. They do exactly what the gestures do. -->
            <LinearLayout
                android:id="@+id/swipeButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/space_16">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionUndo"
                    style="@style/Widget.CineFiles.RoundActionButton"
                    android:layout_width="@dimen/round_button_size"
                    android:layout_height="@dimen/round_button_size"
                    android:contentDescription="@string/swipe_undo"
                    app:icon="@drawable/ic_undo"
                    app:iconTint="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionPass"
                    style="@style/Widget.CineFiles.RoundActionButton.Large"
                    android:layout_width="@dimen/round_button_large_size"
                    android:layout_height="@dimen/round_button_large_size"
                    android:layout_marginStart="@dimen/space_16"
                    android:contentDescription="@string/swipe_pass"
                    app:backgroundTint="@color/pass_red_tint"
                    app:icon="@drawable/ic_close"
                    app:iconTint="@color/pass_red" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionLike"
                    style="@style/Widget.CineFiles.RoundActionButton.Large"
                    android:layout_width="@dimen/round_button_large_size"
                    android:layout_height="@dimen/round_button_large_size"
                    android:layout_marginStart="@dimen/space_16"
                    android:contentDescription="@string/swipe_like"
                    app:backgroundTint="@color/like_green_tint"
                    app:icon="@drawable/ic_heart"
                    app:iconTint="@color/like_green" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionInfo"
                    style="@style/Widget.CineFiles.RoundActionButton"
                    android:layout_width="@dimen/round_button_size"
                    android:layout_height="@dimen/round_button_size"
                    android:layout_marginStart="@dimen/space_16"
                    android:contentDescription="@string/swipe_info"
                    app:icon="@drawable/ic_info"
                    app:iconTint="@color/text_primary" />

            </LinearLayout>
        </LinearLayout>

        <!-- ERROR and EMPTY: hidden until needed -->
        <include
            android:id="@+id/stateError"
            layout="@layout/view_state_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/view_state_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>
</LinearLayout>

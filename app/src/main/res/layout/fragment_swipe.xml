<?xml version="1.0" encoding="utf-8"?>
<!-- SWIPE. A dark stage with soft light behind it (AmbientGlowView): the light takes the color of the
     poster on top, and leans red while you drag to like, slate while you drag to pass.
     On top of it, top to bottom: the top bar (close, progress + moods, Picks pill, thin progress bar),
     the pile of cards (all the remaining height), and the four round buttons.
     It never scrolls, so it fits a small phone. No bottom tab bar on this screen.

     clipChildren="false" on every parent of the cards: they fly out past the edges and cast a shadow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.example.cinefiles.ui.components.AmbientGlowView
        android:id="@+id/swipeGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- ===== Top bar ===== -->
        <LinearLayout
            android:id="@+id/swipeTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/swipeClose"
                    android:layout_width="@dimen/round_button_small_size"
                    android:layout_height="@dimen/round_button_small_size"
                    android:background="@drawable/bg_glass_circle"
                    android:contentDescription="@string/action_close"
                    android:padding="@dimen/space_12"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_primary" />

                <!-- "7 of 20" and the chosen moods. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_marginEnd="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/swipeProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Label"
                        tools:text="7 of 20" />

                    <TextView
                        android:id="@+id/swipeCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                        tools:text="Happy · Romantic" />

                </LinearLayout>

                <!-- Appears after the first like. It takes you to Your Picks. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/swipePicksPill"
                    style="@style/Widget.CineFiles.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/round_button_small_size"
                    android:paddingStart="@dimen/space_16"
                    android:paddingEnd="@dimen/space_16"
                    android:textAppearance="@style/TextAppearance.CineFiles.Label"
                    android:visibility="invisible"
                    app:icon="@drawable/ic_heart_filled"
                    app:iconSize="@dimen/icon_size_small"
                    app:iconTint="@color/like"
                    tools:text="Picks (3)"
                    tools:visibility="visible" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/swipeProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                app:indicatorColor="@color/accent"
                app:trackColor="@color/glass_fill_strong"
                app:trackCornerRadius="@dimen/radius_pill"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="@dimen/swipe_progress_height"
                tools:progress="35" />

        </LinearLayout>

        <!-- ===== Everything below the top bar. The error / empty states cover all of it. ===== -->
        <FrameLayout
            android:id="@+id/swipeBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/swipeColumn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <!-- The pile of cards -->
                <FrameLayout
                    android:id="@+id/swipeDeckArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:layout_marginBottom="@dimen/space_24"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.example.cinefiles.ui.swipe.SwipeDeckView
                        android:id="@+id/swipeDeck"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- LOADING: one quiet, empty card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/swipeLoading"
                        style="@style/Widget.CineFiles.Card.Glass"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/state_loading"
                        android:importantForAccessibility="yes"
                        android:visibility="gone" />

                    <!-- END OF THE DECK -->
                    <include
                        android:id="@+id/swipeEnd"
                        layout="@layout/view_swipe_end"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Undo, Pass, Like, Info. They do exactly what the gestures do. -->
                <LinearLayout
                    android:id="@+id/swipeButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/space_16">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/actionUndo"
                        style="@style/Widget.CineFiles.RoundActionButton"
                        android:layout_width="@dimen/round_button_size"
                        android:layout_height="@dimen/round_button_size"
                        android:contentDescription="@string/action_undo"
                        app:icon="@drawable/ic_undo" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/actionPass"
                        style="@style/Widget.CineFiles.RoundActionButton.Large.Pass"
                        android:layout_width="@dimen/round_button_large_size"
                        android:layout_height="@dimen/round_button_large_size"
                        android:layout_marginStart="@dimen/space_16"
                        android:contentDescription="@string/swipe_pass"
                        app:icon="@drawable/ic_close" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/actionLike"
                        style="@style/Widget.CineFiles.RoundActionButton.Large.Like"
                        android:layout_width="@dimen/round_button_large_size"
                        android:layout_height="@dimen/round_button_large_size"
                        android:layout_marginStart="@dimen/space_16"
                        android:contentDescription="@string/action_like"
                        app:icon="@drawable/ic_heart_filled" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/actionInfo"
                        style="@style/Widget.CineFiles.RoundActionButton"
                        android:layout_width="@dimen/round_button_size"
                        android:layout_height="@dimen/round_button_size"
                        android:layout_marginStart="@dimen/space_16"
                        android:contentDescription="@string/detail_label"
                        app:icon="@drawable/ic_info" />

                </LinearLayout>
            </LinearLayout>

            <!-- ERROR and EMPTY: hidden until needed -->
            <include
                android:id="@+id/stateError"
                layout="@layout/view_state_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <include
                android:id="@+id/stateEmpty"
                layout="@layout/view_state_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>
    </LinearLayout>

    <!-- The achievement banner waits above the screen. The host only adds room for the status bar. -->
    <FrameLayout
        android:id="@+id/swipeBannerHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:paddingTop="@dimen/space_8">

        <include
            android:id="@+id/swipeBanner"
            layout="@layout/view_achievement_banner" />

    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- TEMP: layout of the stand-in screens (Discover, Collection, Profile, Mood, Details).
     Each one is replaced by its real screen in a later batch (see TEMP.md). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tempRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Only visible on screens that are not tabs (Mood, Details) -->
    <ImageButton
        android:id="@+id/tempBack"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/space_8"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_back"
        android:src="@drawable/ic_back"
        android:visibility="gone"
        app:tint="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:id="@+id/tempTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CineFiles.Title" />

        <TextView
            android:id="@+id/tempMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:maxWidth="@dimen/state_text_max_width"
            android:textAppearance="@style/TextAppearance.CineFiles.Callout" />

        <!-- An optional extra line, hidden unless a screen fills it: the movie id (Details)
             or the summary of the user's choices (Swipe stub) -->
        <TextView
            android:id="@+id/tempExtra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:textAppearance="@style/TextAppearance.CineFiles.Body"
            android:visibility="gone" />

        <!-- Only shown when the screen has an extra button (Profile: open the design gallery) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tempAction"
            style="@style/Widget.CineFiles.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>

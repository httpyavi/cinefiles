<?xml version="1.0" encoding="utf-8"?>
<!-- One badge in the Profile grid: the medal, its name and (while it is not earned) how far along it is.
     No box around it: the medal and the words sit straight on the screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_4"
    android:paddingBottom="@dimen/space_12">

    <com.example.cinefiles.ui.components.AchievementBadgeView
        android:id="@+id/badge"
        android:layout_width="@dimen/badge_medal_size"
        android:layout_height="@dimen/badge_medal_size"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/badgeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_4"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/space_4"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.CineFiles.Caption"
        tools:text="Genre Collector" />

</LinearLayout>

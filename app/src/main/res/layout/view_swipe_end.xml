<?xml version="1.0" encoding="utf-8"?>
<!-- END OF THE DECK: an icon, a title, a line of text and two buttons.
     SwipeFragment fills in the texts, icon and clicks for the two cases:
       - you liked something: "You've seen them all"  [Show my picks] [Keep swiping]
       - no likes:            "Nothing caught your eye?" [Try new cards] [Change mood] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_24"
    android:paddingBottom="@dimen/space_24">

    <ImageView
        android:id="@+id/swipeEndIcon"
        android:layout_width="@dimen/state_icon_size"
        android:layout_height="@dimen/state_icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check"
        app:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/swipeEndTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.CineFiles.Title"
        tools:text="You've seen them all" />

    <TextView
        android:id="@+id/swipeEndMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:maxWidth="@dimen/state_text_max_width"
        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
        tools:text="You liked 3 movies." />

    <!-- The main action: gold -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/swipeEndPrimary"
        style="@style/Widget.CineFiles.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_32"
        tools:text="Show my picks" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/swipeEndSecondary"
        style="@style/Widget.CineFiles.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        tools:text="Keep swiping" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The QUICK VIEW of a pick (QuickViewSheet): a bottom sheet with the title, the match, why it was picked, a short
     description and three actions. Tapping a poster in "More for you" opens it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_24">

    <TextView
        android:id="@+id/quickTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.CineFiles.Title"
        tools:targetApi="28"
        tools:text="Blade Runner 2049" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quickMatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_12"
            android:background="@drawable/bg_match_pill"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_4"
            android:textAppearance="@style/TextAppearance.CineFiles.Label"
            android:textColor="@color/on_accent"
            tools:text="92% match" />

        <TextView
            android:id="@+id/quickMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.CineFiles.Callout"
            tools:text="2017 · Science Fiction, Drama" />
    </LinearLayout>

    <TextView
        android:id="@+id/quickReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:textAppearance="@style/TextAppearance.CineFiles.Label"
        android:textColor="@color/accent_soft"
        tools:text="Similar to La La Land" />

    <TextView
        android:id="@+id/quickDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:ellipsize="end"
        android:maxLines="5"
        android:textAppearance="@style/TextAppearance.CineFiles.Body"
        tools:text="Thirty years after the events of the first film, a new blade runner unearths a long-buried secret." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickDetails"
        style="@style/Widget.CineFiles.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/picks_details" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickAddWatchlist"
        style="@style/Widget.CineFiles.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        app:icon="@drawable/ic_bookmark"
        app:iconGravity="textStart"
        tools:text="Add to Watchlist" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickMarkWatched"
        style="@style/Widget.CineFiles.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/action_mark_watched" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- TEMP: the design gallery. Shows every component and text style so the design system can be
     reviewed on a phone. Removed in Batch 8 (see TEMP.md). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/galleryScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_48">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gallery_title"
            android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/gallery_intro"
            android:textAppearance="@style/TextAppearance.CineFiles.Callout" />

        <!-- ===== Colors ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_colors"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />

        <!-- ===== Text styles ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_type"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gallery_text_large_title"
            android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/gallery_text_title"
            android:textAppearance="@style/TextAppearance.CineFiles.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/gallery_text_headline"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/gallery_text_body"
            android:textAppearance="@style/TextAppearance.CineFiles.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/gallery_text_callout"
            android:textAppearance="@style/TextAppearance.CineFiles.Callout" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/gallery_text_caption"
            android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

        <!-- ===== Buttons ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_buttons"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPrimary"
            style="@style/Widget.CineFiles.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gallery_button_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTonal"
            style="@style/Widget.CineFiles.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/gallery_button_tonal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonText"
            style="@style/Widget.CineFiles.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/gallery_button_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDisabled"
            style="@style/Widget.CineFiles.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:enabled="false"
            android:text="@string/gallery_button_disabled" />

        <!-- ===== Chips ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_chips"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_8"
            app:chipSpacingVertical="@dimen/space_8">

            <com.google.android.material.chip.Chip
                style="@style/Widget.CineFiles.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/gallery_chip_drama" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.CineFiles.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_scifi" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.CineFiles.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_comedy" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.CineFiles.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_thriller" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.CineFiles.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_romance" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.CineFiles.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_chip_animation" />

        </com.google.android.material.chip.ChipGroup>

        <!-- ===== Round action buttons ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_round_buttons"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionPass"
                style="@style/Widget.CineFiles.RoundActionButton"
                android:layout_width="@dimen/round_button_size"
                android:layout_height="@dimen/round_button_size"
                android:contentDescription="@string/gallery_action_pass"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/pass" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionUndo"
                style="@style/Widget.CineFiles.RoundActionButton"
                android:layout_width="@dimen/round_button_size"
                android:layout_height="@dimen/round_button_size"
                android:layout_marginStart="@dimen/space_16"
                android:contentDescription="@string/gallery_action_undo"
                app:icon="@drawable/ic_undo"
                app:iconTint="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionInfo"
                style="@style/Widget.CineFiles.RoundActionButton"
                android:layout_width="@dimen/round_button_size"
                android:layout_height="@dimen/round_button_size"
                android:layout_marginStart="@dimen/space_16"
                android:contentDescription="@string/gallery_action_info"
                app:icon="@drawable/ic_info"
                app:iconTint="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionLike"
                style="@style/Widget.CineFiles.RoundActionButton"
                android:layout_width="@dimen/round_button_size"
                android:layout_height="@dimen/round_button_size"
                android:layout_marginStart="@dimen/space_16"
                android:contentDescription="@string/gallery_action_like"
                app:icon="@drawable/ic_heart"
                app:iconTint="@color/like" />

        </LinearLayout>

        <!-- ===== Icons ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_icons"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <GridLayout
            android:id="@+id/iconGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4" />

        <!-- ===== Posters ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_posters"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.example.cinefiles.ui.components.PosterView
                android:id="@+id/posterOne"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.example.cinefiles.ui.components.PosterView
                android:id="@+id/posterTwo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1" />

            <com.example.cinefiles.ui.components.PosterView
                android:id="@+id/posterThree"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1" />

            <com.example.cinefiles.ui.components.PosterView
                android:id="@+id/posterFour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- ===== Image with scrim ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_scrim"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/scrimImage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/temp_sample_backdrop"
                app:layout_constraintDimensionRatio="16:10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.CineFiles.Large" />

            <!-- The scrim: same size and same corners as the image, stacked on top of it -->
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/scrim_bottom"
                app:layout_constraintBottom_toBottomOf="@id/scrimImage"
                app:layout_constraintEnd_toEndOf="@id/scrimImage"
                app:layout_constraintStart_toStartOf="@id/scrimImage"
                app:layout_constraintTop_toTopOf="@id/scrimImage"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.CineFiles.Large" />

            <TextView
                android:id="@+id/scrimTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_4"
                android:text="@string/gallery_scrim_title"
                android:textAppearance="@style/TextAppearance.CineFiles.Title"
                app:layout_constraintBottom_toTopOf="@id/scrimSubtitle"
                app:layout_constraintEnd_toEndOf="@id/scrimImage"
                app:layout_constraintStart_toStartOf="@id/scrimImage" />

            <TextView
                android:id="@+id/scrimSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:layout_marginEnd="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_16"
                android:text="@string/gallery_scrim_subtitle"
                android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                app:layout_constraintBottom_toBottomOf="@id/scrimImage"
                app:layout_constraintEnd_toEndOf="@id/scrimImage"
                app:layout_constraintStart_toStartOf="@id/scrimImage" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== Corner radii ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_radii"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <GridLayout
            android:id="@+id/radiiGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5" />

        <!-- ===== Loading / empty / error states ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_32"
            android:layout_marginBottom="@dimen/space_12"
            android:text="@string/gallery_section_states"
            android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gallery_state_loading"
            android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

        <!-- The state layouts normally fill a whole screen; here they only take the height they need -->
        <include
            android:id="@+id/stateLoading"
            layout="@layout/view_state_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/gallery_state_empty"
            android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/view_state_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="@string/gallery_state_error"
            android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

        <include
            android:id="@+id/stateError"
            layout="@layout/view_state_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>

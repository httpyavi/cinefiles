<?xml version="1.0" encoding="utf-8"?>
<!-- One group of the Crew section of Movie Details: a small heading ("WRITERS") and the names as tappable chips.
     DetailFragment makes one of these for every kind of crew the movie has (logic/Credits.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_8">

    <TextView
        android:id="@+id/crewRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_4"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
        tools:targetApi="28"
        tools:text="Writers" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/crewChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="@dimen/space_8"
        app:chipSpacingVertical="@dimen/space_4" />
</LinearLayout>

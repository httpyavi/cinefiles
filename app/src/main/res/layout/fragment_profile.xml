<?xml version="1.0" encoding="utf-8"?>
<!-- Redesigned Profile Screen: personal, cinematic film tracking with Favorites, Personal Stats,
     and quick access to Liked, Watchlist, Watched, Personal Ratings, and Diary. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.cinefiles.ui.components.AmbientGlowView
        android:id="@+id/profileGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/profileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <!-- ===== CineFiles Branding Header ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_glass_circle"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/cinefiles_logo_white"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_brand_title"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_brand_subtitle"
                        android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                        android:textColor="@color/accent_soft" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===== User Profile Header ===== -->
            <TextView
                android:id="@+id/profileAvatar"
                android:layout_width="@dimen/avatar_large_size"
                android:layout_height="@dimen/avatar_large_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle"
                tools:text="M" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.CineFiles.Title"
                    tools:targetApi="28"
                    tools:text="Movie Lover" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileEdit"
                    style="@style/Widget.CineFiles.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:contentDescription="@string/profile_edit_description"
                    android:minWidth="@dimen/touch_target"
                    android:text="@string/profile_edit"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/accent" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/profile_member"
                android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow" />

            <!-- ===== Favorites Section (Maximum of 4 Movies) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/profile_favorites_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.Title"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/favoritesCountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_favorites_subtitle"
                    android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                    android:textColor="@color/accent_soft" />

            </LinearLayout>

            <TextView
                android:id="@+id/favoritesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/profile_favorites_empty"
                android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                android:textColor="@color/text_secondary" />

            <!-- The 4 Favorite Movie Slots -->
            <LinearLayout
                android:id="@+id/favoritesRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/slot1"
                    layout="@layout/view_favorite_slot" />

                <include
                    android:id="@+id/slot2"
                    layout="@layout/view_favorite_slot" />

                <include
                    android:id="@+id/slot3"
                    layout="@layout/view_favorite_slot" />

                <include
                    android:id="@+id/slot4"
                    layout="@layout/view_favorite_slot" />

            </LinearLayout>

            <!-- ===== Personal Movie Statistics ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/profile_stats_title"
                android:textAppearance="@style/TextAppearance.CineFiles.Title"
                tools:targetApi="28" />

            <!-- Stats Glass Strip 1: Watched, Liked, Watchlist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_glass_panel"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statWatched"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/text_primary"
                        tools:text="14" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_watched"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/glass_stroke_width"
                    android:layout_height="match_parent"
                    android:background="@color/glass_stroke"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statLiked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/accent_soft"
                        tools:text="9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_liked"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/glass_stroke_width"
                    android:layout_height="match_parent"
                    android:background="@color/glass_stroke"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statWatchlist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/text_primary"
                        tools:text="7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_watchlist"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

            </LinearLayout>

            <!-- Stats Glass Strip 2: Personal Ratings, Diary Entries -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_glass_panel"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statRated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/accent"
                        tools:text="11" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_rated"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/glass_stroke_width"
                    android:layout_height="match_parent"
                    android:background="@color/glass_stroke"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statDiary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/text_primary"
                        tools:text="5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_diary"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

            </LinearLayout>

            <!-- Your taste: top genre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:background="@drawable/bg_glass_panel"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_taste_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                    android:textColor="@color/accent_soft" />

                <TextView
                    android:id="@+id/profileTaste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                    tools:text="Drama · 9 liked movies" />
            </LinearLayout>

            <!-- ===== Library & Journal Quick Access ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/profile_nav_header"
                android:textAppearance="@style/TextAppearance.CineFiles.Title"
                tools:targetApi="28" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical">

                <!-- Row 1: Liked Movies -->
                <LinearLayout
                    android:id="@+id/navLikedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="@color/like" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_liked"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navLikedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        tools:text="9" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Row 2: Watchlist -->
                <LinearLayout
                    android:id="@+id/navWatchlistRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bookmark_filled"
                        app:tint="@color/accent_soft" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_watchlist"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navWatchlistCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        tools:text="7" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Row 3: Watched Movies -->
                <LinearLayout
                    android:id="@+id/navWatchedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_filled"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_watched"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navWatchedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        tools:text="14" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Row 4: Personal Ratings -->
                <LinearLayout
                    android:id="@+id/navRatingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_ratings"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navRatingsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/accent"
                        tools:text="11" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Row 5: Movie Diary -->
                <LinearLayout
                    android:id="@+id/navDiaryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_film"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_diary"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navDiaryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/accent"
                        tools:text="5" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===== About CineFiles: version and TMDB credit ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_glass_panel"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/profile_about_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/aboutVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                    tools:text="Version 1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tmdbBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tmdb_badge"
                        android:importantForAccessibility="no"
                        android:paddingStart="@dimen/space_12"
                        android:paddingTop="@dimen/space_8"
                        android:paddingEnd="@dimen/space_12"
                        android:paddingBottom="@dimen/space_8"
                        android:text="@string/profile_tmdb_badge"
                        android:textAppearance="@style/TextAppearance.CineFiles.Label"
                        android:textColor="@color/tmdb_dark" />

                    <TextView
                        android:id="@+id/tmdbNotice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/profile_tmdb_notice"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Clear my data button ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearData"
                style="@style/Widget.CineFiles.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_24"
                android:text="@string/profile_clear"
                android:textColor="@color/accent" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Redesigned Profile Screen: personal, cinematic film tracking with Favorites, Personal Stats,
     and quick access to Liked, Watchlist, Watched, Personal Ratings, and Diary. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.cinefiles.ui.components.AmbientGlowView
        android:id="@+id/profileGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/profileContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <!-- ===== CineFiles Branding Header ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_glass_circle"
                    android:importantForAccessibility="no"
                    android:padding="6dp"
                    android:src="@drawable/cinefiles_logo_white"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_brand_title"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_brand_subtitle"
                        android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                        android:textColor="@color/accent_soft" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===== User Profile Header ===== -->
            <!-- The photo (or the first letter of the name); tapping it opens the photo chooser. The small camera says so. -->
            <FrameLayout
                android:id="@+id/profileAvatarFrame"
                android:layout_width="@dimen/avatar_large_size"
                android:layout_height="@dimen/avatar_large_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_20"
                android:clickable="true"
                android:contentDescription="@string/profile_photo_change_description"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.example.cinefiles.ui.components.AvatarView
                    android:id="@+id/profileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:avatarTextAppearance="@style/TextAppearance.CineFiles.LargeTitle" />

                <ImageView
                    android:id="@+id/profileAvatarBadge"
                    android:layout_width="@dimen/avatar_badge_size"
                    android:layout_height="@dimen/avatar_badge_size"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_avatar_badge"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/space_4"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/text_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.CineFiles.Title"
                    tools:targetApi="28"
                    tools:text="Movie Lover" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profileEdit"
                    style="@style/Widget.CineFiles.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:contentDescription="@string/profile_edit_description"
                    android:minWidth="@dimen/touch_target"
                    android:text="@string/profile_edit"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/accent" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/profile_member"
                android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow" />

            <!-- ===== Favorites Section (Maximum of 4 Movies) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="@string/profile_favorites_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.Title"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/favoritesCountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_favorites_subtitle"
                    android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                    android:textColor="@color/accent_soft" />

            </LinearLayout>

            <TextView
                android:id="@+id/favoritesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/profile_favorites_empty"
                android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                android:textColor="@color/text_secondary" />

            <!-- The 4 favorite places: a RecyclerView of four slots (FavoritesAdapter). Press and hold a poster, then
                 drag it to another place: the new order is saved when it is dropped. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoritesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="-4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="4"
                tools:listitem="@layout/view_favorite_slot" />

            <!-- ===== Personal Movie Statistics ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/profile_stats_title"
                android:textAppearance="@style/TextAppearance.CineFiles.Title"
                tools:targetApi="28" />

            <!-- Stats Glass Strip 1: Watched, Liked, Watchlist -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_glass_panel"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statWatched"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/text_primary"
                        tools:text="14" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_watched"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/glass_stroke_width"
                    android:layout_height="match_parent"
                    android:background="@color/glass_stroke"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statLiked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/accent_soft"
                        tools:text="9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_liked"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/glass_stroke_width"
                    android:layout_height="match_parent"
                    android:background="@color/glass_stroke"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statWatchlist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/text_primary"
                        tools:text="7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_stats_watchlist"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>

            </LinearLayout>

            <!-- Your taste section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_glass_panel">

                <!-- Populated taste view -->
                <LinearLayout
                    android:id="@+id/tasteContentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_taste_title"
                        android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                        android:textColor="@color/accent_soft" />

                    <TextView
                        android:id="@+id/profileTaste"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                        tools:text="You're drawn to deeply human stories rich with emotion, tension, and unforgettable performances." />

                    <TextView
                        android:id="@+id/profileTasteSupport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                        android:textColor="@color/text_secondary"
                        tools:text="Your favorites lean toward Drama and Romance." />
                </LinearLayout>

                <!-- Empty taste view -->
                <LinearLayout
                    android:id="@+id/tasteEmptyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_20"
                    android:paddingTop="@dimen/space_24"
                    android:paddingEnd="@dimen/space_20"
                    android:paddingBottom="@dimen/space_20">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_glass_circle">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_film"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:text="@string/profile_taste_empty_title"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                        android:textAlignment="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/profile_taste_empty_desc"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        android:textAlignment="center" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreMovies"
                        style="@style/Widget.CineFiles.Button.Tonal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/profile_taste_empty_cta"
                        app:icon="@drawable/ic_discover"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_8" />

                </LinearLayout>

            </FrameLayout>

            <!-- ===== Library & Journal Quick Access ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:accessibilityHeading="true"
                android:text="@string/profile_nav_header"
                android:textAppearance="@style/TextAppearance.CineFiles.Title"
                tools:targetApi="28" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical">

                <!-- Row 1: Liked Movies -->
                <LinearLayout
                    android:id="@+id/navLikedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="@color/like" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_liked"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navLikedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        tools:text="9" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Row 2: Watchlist -->
                <LinearLayout
                    android:id="@+id/navWatchlistRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bookmark_filled"
                        app:tint="@color/accent_soft" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_watchlist"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navWatchlistCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        tools:text="7" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <!-- Row 3: Watched Movies -->
                <LinearLayout
                    android:id="@+id/navWatchedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check_filled"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_watched"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navWatchedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        tools:text="14" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>


                <!-- Row 4: Movie Diary (the pages you wrote) -->
                <LinearLayout
                    android:id="@+id/navDiaryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_glass_panel"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_16">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_book"
                        app:tint="@color/star" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:text="@string/profile_nav_diary"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline" />

                    <TextView
                        android:id="@+id/navDiaryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary"
                        tools:text="3" />

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

            </LinearLayout>

            <!-- ===== About CineFiles: version and TMDB credit ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_glass_panel"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/profile_about_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                    tools:targetApi="28" />

                <TextView
                    android:id="@+id/aboutVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                    tools:text="Version 1.0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tmdbBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tmdb_badge"
                        android:importantForAccessibility="no"
                        android:paddingStart="@dimen/space_12"
                        android:paddingTop="@dimen/space_8"
                        android:paddingEnd="@dimen/space_12"
                        android:paddingBottom="@dimen/space_8"
                        android:text="@string/profile_tmdb_badge"
                        android:textAppearance="@style/TextAppearance.CineFiles.Label"
                        android:textColor="@color/tmdb_dark" />

                    <TextView
                        android:id="@+id/tmdbNotice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:text="@string/profile_tmdb_notice"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Clear my data button ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearData"
                style="@style/Widget.CineFiles.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginBottom="@dimen/space_24"
                android:text="@string/profile_clear"
                android:textColor="@color/accent" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>

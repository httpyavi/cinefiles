<?xml version="1.0" encoding="utf-8"?>
<!-- HOME. One scrolling page. It opens on a full-bleed picture of today's featured movie (no card around it)
     with the greeting, search and avatar floating on top of it, then Trending This Week, Popular Now and
     one glass strip with the three collection numbers.
     The loading / empty / error states share the scrolling area's space. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Scrolling content (also shows the placeholders while loading) ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_nav_height"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Block 1: the hero. While loading, only the quiet empty surface is visible. -->
            <FrameLayout
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:background="@color/surface"
                android:clipChildren="false">

                <FrameLayout
                    android:id="@+id/heroFilled"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/heroImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <!-- a soft shade at the top for the header, a deep one at the bottom for the title -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hero_top_scrim_height"
                        android:layout_gravity="top"
                        android:background="@drawable/scrim_top"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hero_scrim_height"
                        android:layout_gravity="bottom"
                        android:background="@drawable/scrim_bottom"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin"
                        android:paddingBottom="@dimen/space_24">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_featured_label"
                            android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                            android:textColor="@color/accent_soft" />

                        <TextView
                            android:id="@+id/heroTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle"
                            tools:text="Blade Runner 2049" />

                        <TextView
                            android:id="@+id/heroMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                            tools:text="2017 · Science Fiction, Drama" />

                        <!-- The one big call to action of the screen: it starts the journey.
                             A red gradient pill with a soft glow, a play badge on the left and an arrow on the
                             right that gives a small nudge every few seconds (see HomeFragment). -->
                        <LinearLayout
                            android:id="@+id/heroButton"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/cta_height"
                            android:layout_marginTop="@dimen/space_20"
                            android:background="@drawable/bg_cta"
                            android:clickable="true"
                            android:clipChildren="false"
                            android:elevation="@dimen/cta_glow_elevation"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:outlineAmbientShadowColor="@color/accent"
                            android:outlineSpotShadowColor="@color/accent"
                            android:paddingStart="@dimen/space_12"
                            android:paddingEnd="@dimen/space_20"
                            android:stateListAnimator="@animator/glow_press_scale"
                            tools:targetApi="28">

                            <FrameLayout
                                android:layout_width="@dimen/cta_badge_size"
                                android:layout_height="@dimen/cta_badge_size"
                                android:background="@drawable/bg_glass_circle">

                                <ImageView
                                    android:layout_width="@dimen/icon_size"
                                    android:layout_height="@dimen/icon_size"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_play"
                                    app:tint="@color/on_accent" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/heroButtonText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/home_hero_button"
                                android:textAppearance="@style/TextAppearance.CineFiles.Cta" />

                            <ImageView
                                android:id="@+id/heroButtonArrow"
                                android:layout_width="@dimen/icon_size"
                                android:layout_height="@dimen/icon_size"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="@color/on_accent" />

                        </LinearLayout>

                    </LinearLayout>
                </FrameLayout>

                <!-- ===== Header: greeting, search, avatar. It floats on the picture. ===== -->
                <LinearLayout
                    android:id="@+id/homeHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_12">

                    <!-- The CineFiles logo -->
                    <ImageView
                        android:id="@+id/homeLogo"
                        android:layout_width="@dimen/logo_header_width"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_12"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/cinefiles_logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/greetingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                            tools:text="Good evening" />

                        <TextView
                            android:id="@+id/userNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CineFiles.Title"
                            tools:text="Movie Lover" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/searchButton"
                        android:layout_width="@dimen/round_button_small_size"
                        android:layout_height="@dimen/round_button_small_size"
                        android:background="@drawable/bg_glass_circle"
                        android:contentDescription="@string/home_search_description"
                        android:padding="@dimen/space_12"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_primary" />

                    <!-- The ring is drawn by bg_avatar (40 dp); the view is 48 dp so it is easy to tap -->
                    <TextView
                        android:id="@+id/avatarButton"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_marginStart="@dimen/space_4"
                        android:background="@drawable/bg_avatar"
                        android:clickable="true"
                        android:contentDescription="@string/nav_profile"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                        tools:text="M" />

                </LinearLayout>
            </FrameLayout>

            <!-- Block 2: Trending This Week -->
            <LinearLayout
                android:id="@+id/trendingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:layout_marginBottom="@dimen/space_12"
                    android:accessibilityHeading="true"
    tools:targetApi="28"
                    android:text="@string/home_trending_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.Title" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/poster_row_height">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trendingList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/space_8"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <include
                        android:id="@+id/trendingLoading"
                        layout="@layout/view_row_loading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </FrameLayout>
            </LinearLayout>

            <!-- Block 3: Popular Now -->
            <LinearLayout
                android:id="@+id/popularSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/screen_margin"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/screen_margin"
                    android:layout_marginBottom="@dimen/space_12"
                    android:accessibilityHeading="true"
    tools:targetApi="28"
                    android:text="@string/home_popular_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.Title" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/poster_row_height">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/popularList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/space_8"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <include
                        android:id="@+id/popularLoading"
                        layout="@layout/view_row_loading"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </FrameLayout>
            </LinearLayout>

            <!-- Block 4: your collection, as ONE glass strip (three numbers, no boxes inside boxes) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginBottom="@dimen/space_12"
                android:accessibilityHeading="true"
    tools:targetApi="28"
                android:text="@string/home_collection_title"
                android:textAppearance="@style/TextAppearance.CineFiles.Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginBottom="@dimen/space_24"
                android:background="@drawable/bg_glass_panel"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileLiked"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <TextView
                        android:id="@+id/likedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        android:textColor="@color/accent_soft"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_liked"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/glass_stroke_width"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:background="@color/glass_stroke"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/tileWatchlist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <TextView
                        android:id="@+id/watchlistCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_collection_watchlist"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/glass_stroke_width"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_16"
                    android:background="@color/glass_stroke"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/tileWatched"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_16"
                    android:paddingBottom="@dimen/space_16">

                    <TextView
                        android:id="@+id/watchedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CineFiles.Title"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_watched"
                        android:textAppearance="@style/TextAppearance.CineFiles.Caption" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== EMPTY and ERROR states (hidden until needed) ===== -->
    <include
        android:id="@+id/stateEmpty"
        layout="@layout/view_state_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <include
        android:id="@+id/stateError"
        layout="@layout/view_state_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>

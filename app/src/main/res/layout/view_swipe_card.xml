<?xml version="1.0" encoding="utf-8"?>
<!-- Contents of SwipeCardView: a full-bleed poster, a soft scrim, the title with the rating / year / genres,
     and the like / pass feedback (a veil and a centered icon) that appears only while the card is dragged.
     The rounded corners (24 dp), the light edge and the shadow are done by SwipeCardView itself. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

    <!-- surface color shows while the poster is still loading -->
    <ImageView
        android:id="@+id/cardPoster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/swipe_scrim_height"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="@dimen/space_20">

        <!-- Why this movie is here: "Top rated", "Hidden gem"... -->
        <TextView
            android:id="@+id/cardEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
            android:textColor="@color/accent_soft"
            tools:text="Top rated" />

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.CineFiles.Title"
            tools:text="The Shawshank Redemption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The rating in a small glass pill -->
            <LinearLayout
                android:id="@+id/cardRatingPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_8"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/space_12"
                android:paddingBottom="@dimen/space_4">

                <ImageView
                    android:id="@+id/cardStar"
                    android:layout_width="@dimen/icon_size_small"
                    android:layout_height="@dimen/icon_size_small"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/star" />

                <TextView
                    android:id="@+id/cardRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.CineFiles.Label"
                    tools:text="8.7" />

            </LinearLayout>

            <TextView
                android:id="@+id/cardMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                tools:text="1994 · Drama, Crime" />

        </LinearLayout>
    </LinearLayout>

    <!-- Swipe feedback. At rest all four are invisible and the poster is untouched. While the card is dragged,
         a see-through red (right) or slate (left) veil fades in over the poster and a big heart or X grows in
         the middle; SwipeCardView.setFeedback() sets their opacity and size from the distance dragged. -->
    <View
        android:id="@+id/overlayLike"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/accent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/overlayPass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/pass_overlay"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/iconLike"
        android:layout_width="@dimen/swipe_feedback_icon_size"
        android:layout_height="@dimen/swipe_feedback_icon_size"
        android:layout_gravity="center"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_heart_filled"
        app:tint="@color/on_accent" />

    <ImageView
        android:id="@+id/iconPass"
        android:layout_width="@dimen/swipe_feedback_icon_size"
        android:layout_height="@dimen/swipe_feedback_icon_size"
        android:layout_gravity="center"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_close"
        app:tint="@color/on_accent" />

    <!-- A flat surface-colored sheet over the whole card. A card waiting BEHIND the top card is fully covered
         by it (so it reads as a quiet tonal card); the sheet fades away as the card comes to the front. -->
    <View
        android:id="@+id/cardDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:importantForAccessibility="no" />

</merge>

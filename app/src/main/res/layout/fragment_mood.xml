<?xml version="1.0" encoding="utf-8"?>
<!-- MOOD: "What are you feeling today?" Step 1 of 3.
     Top bar (close + step indicator) and footer (counter + Continue) are FIXED.
     Only the title, hint and the grid of cards in between scroll, so on a short phone the
     footer is always visible. No bottom tab bar on this screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/moodTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_8"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8">

        <ImageButton
            android:id="@+id/moodClose"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <com.example.cinefiles.ui.components.StepIndicatorView
            android:id="@+id/moodStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:currentStep="1" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/moodScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <!-- clipChildren=false on every parent of the cards, so a selected (slightly bigger) card is not cut off -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/mood_title"
                android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/mood_hint"
                android:textAppearance="@style/TextAppearance.CineFiles.Callout" />

            <!-- The grid does not scroll by itself: the NestedScrollView around it does -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/moodGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/mood_grid_padding"
                android:paddingEnd="@dimen/mood_grid_padding"
                android:paddingBottom="@dimen/space_8"
                tools:itemCount="9"
                tools:listitem="@layout/item_mood_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/moodFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_16">

        <TextView
            android:id="@+id/moodCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.CineFiles.Callout"
            tools:text="2 of 3 selected" />

        <!-- Gold, and dim until at least one mood is selected -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            style="@style/Widget.CineFiles.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/mood_continue" />

    </LinearLayout>
</LinearLayout>

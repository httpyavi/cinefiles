<?xml version="1.0" encoding="utf-8"?>
<!-- MOOD SELECTION: "What are you feeling today?" Step 1 of 3.
     Features an interactive swipable mood character with ambient glow,
     expressive Poppins typography, and clear visual hierarchy. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Subtle ambient radial glow behind the character -->
    <com.example.cinefiles.ui.components.AmbientGlowView
        android:id="@+id/moodGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: Close & Step Indicator -->
        <FrameLayout
            android:id="@+id/moodTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12">

            <ImageButton
                android:id="@+id/moodClose"
                android:layout_width="@dimen/round_button_small_size"
                android:layout_height="@dimen/round_button_small_size"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/action_close"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_close"
                app:tint="@color/text_primary" />

            <com.example.cinefiles.ui.components.StepIndicatorView
                android:id="@+id/moodStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:currentStep="1" />

        </FrameLayout>

        <!-- Scrollable content to ensure usability across all screen sizes -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/moodScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_8">

                <!-- 1. Small label: YOUR MOOD -->
                <TextView
                    android:id="@+id/moodEyebrowLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="@string/mood_eyebrow"
                    android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow"
                    android:textColor="@color/accent_soft" />

                <!-- 2. Main heading: What are you feeling today? -->
                <TextView
                    android:id="@+id/moodTitleHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/mood_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle"
                    android:textColor="@color/text_primary"
                    tools:targetApi="28" />

                <!-- 3. Visible instruction: Swipe left or right to explore moods -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/moodSwipeInstruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/mood_swipe_instruction"
                        android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- 4. Large Swipable Mood Character Area with Directional Cues -->
                <FrameLayout
                    android:id="@+id/moodFaceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="@dimen/space_8"
                    android:clipChildren="false">

                    <!-- Previous mood directional cue / button -->
                    <ImageButton
                        android:id="@+id/moodPrev"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_glass_circle"
                        android:contentDescription="@string/mood_prev_description"
                        android:padding="@dimen/space_12"
                        android:src="@drawable/ic_back"
                        app:tint="@color/text_primary" />

                    <!-- The interactive Character -->
                    <com.example.cinefiles.ui.mood.MoodFaceView
                        android:id="@+id/moodFace"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_40"
                        android:layout_marginEnd="@dimen/space_40"
                        android:clickable="true"
                        android:focusable="true"
                        android:importantForAccessibility="no" />

                    <!-- Next mood directional cue / button -->
                    <ImageButton
                        android:id="@+id/moodNext"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_glass_circle"
                        android:contentDescription="@string/mood_next_description"
                        android:padding="@dimen/space_12"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/text_primary" />

                </FrameLayout>

                <!-- 5. Selected mood name -->
                <TextView
                    android:id="@+id/moodName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.CineFiles.Display"
                    tools:text="Happy" />

                <!-- 6. Short mood description -->
                <TextView
                    android:id="@+id/moodLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_horizontal"
                    android:minLines="2"
                    android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                    tools:text="Bright, funny, feel-good movies." />

                <!-- 7. Add mood button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/moodToggle"
                    style="@style/Widget.CineFiles.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_8"
                    android:minHeight="@dimen/chip_height"
                    android:paddingStart="@dimen/space_20"
                    android:paddingEnd="@dimen/space_20"
                    android:text="@string/mood_add"
                    app:icon="@drawable/ic_add"
                    app:iconSize="@dimen/icon_size_small" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 8. Footer: Selected mood pills & Continue CTA -->
        <LinearLayout
            android:id="@+id/moodFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_16">

            <TextView
                android:id="@+id/moodCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                tools:text="2 of 3 selected" />

            <!-- The chosen mood pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_4"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/moodChips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    app:chipSpacingHorizontal="@dimen/space_8"
                    app:singleLine="true" />

            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.CineFiles.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/mood_continue"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>

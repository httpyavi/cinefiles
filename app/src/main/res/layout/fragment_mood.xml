<?xml version="1.0" encoding="utf-8"?>
<!-- MOOD SELECTION: "What are you feeling today?" Step 1 of 3.
     Redesigned with a 2-column, 5-row grid of the exact 10 mood choices,
     informative feature card, and dark cinematic styling. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Subtle ambient radial glow responding to selection -->
    <com.example.cinefiles.ui.components.AmbientGlowView
        android:id="@+id/moodGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top bar: Close & Step Indicator -->
        <FrameLayout
            android:id="@+id/moodTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12">

            <ImageButton
                android:id="@+id/moodClose"
                android:layout_width="@dimen/round_button_small_size"
                android:layout_height="@dimen/round_button_small_size"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/action_close"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_close"
                app:tint="@color/text_primary" />

            <com.example.cinefiles.ui.components.StepIndicatorView
                android:id="@+id/moodStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:currentStep="1" />

        </FrameLayout>

        <!-- Scrollable content to ensure comfort across all screen sizes -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/moodScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_12">

                <!-- 1. Main heading: "What are you feeling today?" -->
                <TextView
                    android:id="@+id/moodTitleHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/mood_title"
                    android:textAppearance="@style/TextAppearance.CineFiles.LargeTitle"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    tools:targetApi="28" />

                <!-- 2. Clear short instruction: "Choose up to 3 moods" -->
                <TextView
                    android:id="@+id/moodInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/mood_choose_instruction"
                    android:textAppearance="@style/TextAppearance.CineFiles.Callout"
                    android:textColor="@color/accent_soft" />

                <!-- 3. Feature Card: "Your mood sets the scene" -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/moodExplanationCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:layout_marginBottom="@dimen/space_8"
                    app:cardBackgroundColor="@color/elevated"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_16"
                        android:paddingTop="@dimen/space_12"
                        android:paddingEnd="@dimen/space_16"
                        android:paddingBottom="@dimen/space_12">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sparkle"
                            app:tint="@color/accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_12"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/mood_scene_title"
                                android:textAppearance="@style/TextAppearance.CineFiles.Headline"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingExtra="1dp"
                                android:text="@string/mood_scene_description"
                                android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Two-Column Mood Selection Grid (10 moods, 5 rows x 2 cols) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/moodGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 5. Footer: Selected mood pills & Continue CTA -->
        <LinearLayout
            android:id="@+id/moodFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_16">

            <TextView
                android:id="@+id/moodCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                tools:text="2 of 3 selected" />

            <!-- The chosen mood pills -->
            <HorizontalScrollView
                android:id="@+id/moodChipsScroll"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:layout_marginTop="@dimen/space_4"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/moodChips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    app:chipSpacingHorizontal="@dimen/space_8"
                    app:singleLine="true" />

            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.CineFiles.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/mood_continue"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>

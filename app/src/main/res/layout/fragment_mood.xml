<?xml version="1.0" encoding="utf-8"?>
<!-- MOOD: "What are you feeling today?" Step 1 of 3.
     One big animated face, and a slider under it that runs through all the moods. The light behind
     everything takes the color of the mood. Nothing scrolls, so it fits a small phone.
     Tap the face (or the pill under the name) to add the mood to your mix; up to three.
     No bottom tab bar on this screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.cinefiles.ui.components.AmbientGlowView
        android:id="@+id/moodGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/moodTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_12"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_12">

            <ImageButton
                android:id="@+id/moodClose"
                android:layout_width="@dimen/round_button_small_size"
                android:layout_height="@dimen/round_button_small_size"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="@string/action_close"
                android:padding="@dimen/space_12"
                android:src="@drawable/ic_close"
                app:tint="@color/text_primary" />

            <com.example.cinefiles.ui.components.StepIndicatorView
                android:id="@+id/moodStepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:currentStep="1" />

        </FrameLayout>

        <TextView
            android:id="@+id/moodEyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_margin"
            android:accessibilityHeading="true"
    tools:targetApi="28"
            android:gravity="center"
            android:text="@string/mood_title"
            android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow" />

        <!-- The face takes whatever height is left. It is decoration: the pill below does the same job for TalkBack. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:minHeight="@dimen/mood_face_min_height">

            <com.example.cinefiles.ui.mood.MoodFaceView
                android:id="@+id/moodFace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <TextView
            android:id="@+id/moodName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/screen_margin"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.CineFiles.Display"
            tools:text="Happy" />

        <!-- Two lines are always kept free, so the screen does not jump when the sentence changes length -->
        <TextView
            android:id="@+id/moodLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginEnd="@dimen/screen_margin"
            android:gravity="center_horizontal"
            android:minLines="2"
            android:textAppearance="@style/TextAppearance.CineFiles.Callout"
            tools:text="Bright, funny, feel-good movies." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moodToggle"
            style="@style/Widget.CineFiles.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:minHeight="@dimen/chip_height"
            android:paddingStart="@dimen/space_20"
            android:paddingEnd="@dimen/space_20"
            android:text="@string/mood_add"
            app:icon="@drawable/ic_add"
            app:iconSize="@dimen/icon_size_small" />

        <!-- The slider, with the two ends of the spectrum named under it (in the slider's own space) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/mood_slider_height"
            android:layout_marginTop="@dimen/space_4">

            <com.example.cinefiles.ui.mood.MoodSliderView
                android:id="@+id/moodSlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/mood_slider_description" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/screen_margin"
                android:importantForAccessibility="no"
                android:text="@string/mood_slider_cozy"
                android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/screen_margin"
                android:importantForAccessibility="no"
                android:text="@string/mood_slider_wild"
                android:textAppearance="@style/TextAppearance.CineFiles.Eyebrow" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/moodFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_16">

            <!-- "Tap the face to add a mood" before the first one, then "2 of 3 selected" -->
            <TextView
                android:id="@+id/moodCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.CineFiles.Caption"
                tools:text="2 of 3 selected" />

            <!-- The chosen moods. Tap the x on one to take it out. -->
            <!-- A fixed height, so the screen does not jump when the first chip appears -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/moodChips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    app:chipSpacingHorizontal="@dimen/space_8"
                    app:singleLine="true" />

            </HorizontalScrollView>

            <!-- Red, and dim until at least one mood is chosen -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.CineFiles.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/mood_continue" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>

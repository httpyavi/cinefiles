<?xml version="1.0" encoding="utf-8"?>
<!-- The new screen fades in (and grows from 92% to 100%) AFTER the old one has faded out.
     Together with fade_through_exit this is the "fade through" used when switching tabs. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha
        android:duration="210"
        android:fromAlpha="0"
        android:startOffset="90"
        android:toAlpha="1" />
    <scale
        android:duration="210"
        android:fromXScale="0.92"
        android:fromYScale="0.92"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="90"
        android:toXScale="1"
        android:toYScale="1" />
</set>

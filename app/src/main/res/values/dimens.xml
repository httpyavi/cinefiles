<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Spacing: a 4 dp grid. The name is the size in dp. ===== -->
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_10">10dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_20">20dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_32">32dp</dimen>
    <dimen name="space_40">40dp</dimen>

    <!-- Every screen has 20 dp left/right margins -->
    <dimen name="screen_margin">20dp</dimen>

    <!-- ===== Corner radii ===== -->
    <dimen name="radius_small">8dp</dimen>
    <dimen name="radius_medium">12dp</dimen>   <!-- posters -->
    <dimen name="radius_large">16dp</dimen>    <!-- cards, images -->
    <dimen name="radius_xlarge">24dp</dimen>   <!-- sheets -->
    <dimen name="radius_pill">100dp</dimen>    <!-- bigger than half any control height = a pill -->

    <!-- ===== Sizes ===== -->
    <dimen name="icon_size">24dp</dimen>
    <dimen name="icon_size_small">16dp</dimen>   <!-- inside poster badges -->
    <dimen name="touch_target">48dp</dimen>      <!-- smallest tappable area -->
    <dimen name="button_height">52dp</dimen>
    <dimen name="chip_height">40dp</dimen>       <!-- Material adds invisible padding up to 48 dp for touch -->
    <dimen name="round_button_size">56dp</dimen>
    <dimen name="round_button_small_size">48dp</dimen>   <!-- back / close / search: the smallest tap area (touch_target) -->
    <dimen name="glass_stroke_width">1dp</dimen>   <!-- the light edge of every glass surface -->
    <dimen name="glow_elevation">10dp</dimen>      <!-- gives a red button its soft red glow (API 28+) -->
    <dimen name="glow_elevation_pressed">4dp</dimen>
    <dimen name="badge_size">28dp</dimen>        <!-- poster status badge circle -->
    <dimen name="badge_padding">6dp</dimen>      <!-- (badge_size - icon_size_small) / 2 -->
    <dimen name="end_icon_plate_size">80dp</dimen> <!-- the glass plate behind the icon of the end-of-deck screen -->
    <dimen name="state_text_max_width">280dp</dimen>

    <!-- Tab screens: height of the bottom tab bar (without the system navigation-bar inset).
         A tab screen reserves this much space at its bottom (android:paddingBottom) because the bar
         floats above the content. -->
    <dimen name="bottom_nav_height">92dp</dimen>
    <dimen name="bottom_nav_bar_height">64dp</dimen>     <!-- the floating pill itself -->
    <dimen name="bottom_nav_margin_side">24dp</dimen>   <!-- gap to the screen edge, left and right -->
    <dimen name="bottom_nav_margin_bottom">12dp</dimen> <!-- gap above the gesture bar -->
    <dimen name="nav_indicator_width">56dp</dimen>
    <dimen name="nav_indicator_height">32dp</dimen>

    <!-- Launch splash -->
    <dimen name="launch_logo_width">180dp</dimen>         <!-- the logo on the red launch screen (the height follows its shape) -->

    <!-- Home screen -->
    <dimen name="logo_header_width">56dp</dimen>          <!-- the logo in the Home header (the height follows its shape) -->
    <dimen name="cta_height">64dp</dimen>                 <!-- the big "Let's watch something!" button -->
    <dimen name="cta_badge_size">40dp</dimen>             <!-- the round play badge inside it -->
    <dimen name="cta_glow_elevation">12dp</dimen>
    <dimen name="cta_arrow_nudge">6dp</dimen>             <!-- how far its arrow slides when it nudges -->
    <dimen name="hero_height">420dp</dimen>
    <dimen name="hero_scrim_height">300dp</dimen>
    <dimen name="hero_top_scrim_height">140dp</dimen>
    <!-- Your Picks -->
    <dimen name="picks_top_match_height">280dp</dimen>      <!-- the backdrop of the Top Match card -->
    <dimen name="picks_top_match_scrim_height">200dp</dimen>
    <dimen name="picks_progress_width">220dp</dimen>        <!-- the thin bar of the "building your picks" moment -->

    <!-- Movie Details: the backdrop picture at the top, a little shorter than Home's hero -->
    <dimen name="detail_hero_height">360dp</dimen>
    <dimen name="detail_poster_width">104dp</dimen>       <!-- the tappable poster in the hero (the height follows the 2:3 shape) -->
    <dimen name="detail_poster_zoom_size">28dp</dimen>    <!-- the small "see it bigger" plate in its corner -->
    <dimen name="cast_item_width">100dp</dimen>           <!-- one actor in the Cast row (wide enough that a long surname does not break at 130% text) -->
    <dimen name="cast_photo_size">72dp</dimen>

    <!-- Person screen -->
    <dimen name="person_photo_size">96dp</dimen>
    <!-- Poster rows: 112 dp wide, so on most phones three posters fit and a bit of the 4th peeks in,
         which tells you the row scrolls. The height is 1.5 x the width (posters are 2:3). -->
    <dimen name="poster_row_width">112dp</dimen>
    <dimen name="poster_row_height">168dp</dimen>

    <!-- Mood screen -->
    <dimen name="mood_face_min_height">120dp</dimen>      <!-- the animated face never gets smaller than this -->
    <dimen name="mood_slider_height">72dp</dimen>
    <dimen name="mood_slider_handle_radius">20dp</dimen>
    <dimen name="mood_slider_track_thickness">12dp</dimen>
    <dimen name="mood_slider_tick_radius">2.5dp</dimen>
    <dimen name="mood_text_shift">12dp</dimen>            <!-- how far the mood name slides when it changes -->

    <!-- Swipe screen -->
    <dimen name="swipe_card_elevation">12dp</dimen>       <!-- the soft shadow of the TOP card only -->
    <dimen name="swipe_next_card_offset">24dp</dimen>     <!-- the card behind sits this much lower -->
    <dimen name="swipe_scrim_height">300dp</dimen>
    <dimen name="swipe_progress_height">4dp</dimen>
    <dimen name="swipe_feedback_icon_size">96dp</dimen>   <!-- the popcorn / X in the middle of a dragged card (at full size) -->
    <dimen name="swipe_fling_velocity">600dp</dimen>      <!-- a flick faster than 600 dp per second counts as a swipe -->
    <dimen name="icon_size_large">32dp</dimen>
    <dimen name="round_button_large_size">72dp</dimen>    <!-- Pass and Like -->

    <!-- Achievements and Profile -->
    <dimen name="badge_medal_size">72dp</dimen>
    <dimen name="badge_ring_width">3dp</dimen>
    <dimen name="avatar_large_size">88dp</dimen>
    <dimen name="avatar_badge_size">28dp</dimen>          <!-- the little camera on the profile photo -->
    <dimen name="avatar_badge_edge">2dp</dimen>
    <dimen name="banner_icon_size">40dp</dimen>
    <dimen name="banner_slide">96dp</dimen>               <!-- how far above the screen the banner waits -->

    <!-- Step indicator (the little "Step 1 of 3" bars) -->
    <dimen name="step_segment_width">20dp</dimen>
    <dimen name="step_segment_height">4dp</dimen>

    <!-- Loading-state placeholder shapes -->
    <dimen name="placeholder_heading_width">160dp</dimen>
    <dimen name="placeholder_line_short_width">200dp</dimen>


    <!-- Popcorn rating, crew and diary -->
    <dimen name="popcorn_size">40dp</dimen>               <!-- one bucket of the rating on Details -->
    <dimen name="popcorn_gap">8dp</dimen>
    <dimen name="popcorn_size_small">16dp</dimen>         <!-- a read-only rating in the diary list -->
    <dimen name="popcorn_size_diary_header">12dp</dimen>  <!-- slightly smaller rating in the diary editor header -->
    <dimen name="popcorn_gap_small">2dp</dimen>
    <dimen name="crew_label_width">124dp</dimen>          <!-- the role column of the Crew section ("Cinematography" fits on one line) -->
    <dimen name="diary_cover_width">64dp</dimen>          <!-- the small poster of a diary page in the list -->
    <dimen name="diary_option_width">112dp</dimen>        <!-- one font or theme card in the style sheet -->
    <dimen name="diary_option_selected_stroke">2dp</dimen>
    <dimen name="diary_still_height">96dp</dimen>         <!-- one movie still in the picker -->
    <dimen name="diary_poster_thumb_width">36dp</dimen>   <!-- the small poster beside the movie's name on a diary page -->
    <dimen name="diary_poster_thumb_height">54dp</dimen>
    <dimen name="diary_cover_height">200dp</dimen>        <!-- the cover picture across a diary page -->
    <dimen name="diary_body_min_height">240dp</dimen>     <!-- the body of a page is at least this tall, so a tap below the words still writes -->
    <dimen name="diary_quote_bar">3dp</dimen>             <!-- the bar of a pull-quote -->
    <dimen name="diary_quote_gap">12dp</dimen>            <!-- the space between that bar and the quoted words -->
    <dimen name="diary_rule_width">56dp</dimen>           <!-- the short accent line under a page's headline -->
    <dimen name="diary_rule_height">3dp</dimen>
    <dimen name="format_button_size">44dp</dimen>         <!-- a button of the diary's formatting strip -->
    <dimen name="image_tool_size">36dp</dimen>            <!-- a tool on a picture of a diary page -->

    <!-- Make it yours -->
    <dimen name="pref_card_min_height">64dp</dimen>        <!-- every era / runtime / rating card is at least this tall, so a row never looks jagged -->
    <dimen name="pref_dropdown_height">240dp</dimen>       <!-- the language suggestions: about four and a half rows, then it scrolls -->
</resources>

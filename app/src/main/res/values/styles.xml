<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =====================================================================
         TYPE
         The font is named in exactly two places: the two base styles just below.
         Today it is Android's built-in Roboto ("sans-serif").
         To switch to Inter later: put the Inter files in res/font/ and change the
         two android:fontFamily lines to @font/inter_regular and @font/inter_medium.
         (On Android 7.x, also add the app:fontFamily line with the same value.)

         The feel is editorial: big titles with slightly tight letters, and small
         spaced-out capitals (Eyebrow) above them, like a film poster credit line.
         ===================================================================== -->

    <style name="TextAppearance.CineFiles.Regular" parent="">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CineFiles.Medium" parent="TextAppearance.CineFiles.Regular">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextAppearance.CineFiles.SemiBold" parent="TextAppearance.CineFiles.Regular">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextAppearance.CineFiles.Bold" parent="TextAppearance.CineFiles.Regular">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="fontFamily">@font/poppins_bold</item>
    </style>

    <!-- The sizes of the design system -->

    <!-- Display: one huge word, like the mood name or a hero title -->
    <style name="TextAppearance.CineFiles.Display" parent="TextAppearance.CineFiles.Bold">
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.CineFiles.LargeTitle" parent="TextAppearance.CineFiles.Bold">
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="TextAppearance.CineFiles.Title" parent="TextAppearance.CineFiles.SemiBold">
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.CineFiles.Headline" parent="TextAppearance.CineFiles.SemiBold">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.CineFiles.Body" parent="TextAppearance.CineFiles.Regular">
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Callout and Caption are secondary information, so they are gray by default -->
    <style name="TextAppearance.CineFiles.Callout" parent="TextAppearance.CineFiles.Regular">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CineFiles.Caption" parent="TextAppearance.CineFiles.Regular">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Eyebrow: a small line of capitals above a title ("FEATURED TODAY"). Gray; add the accent
         color with android:textColor where it should shout. -->
    <style name="TextAppearance.CineFiles.Eyebrow" parent="TextAppearance.CineFiles.SemiBold">
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- The small red "87%" match pill on a pick: small enough for a three-column grid -->
    <style name="TextAppearance.CineFiles.Pill" parent="TextAppearance.CineFiles.Medium">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The label of the big Home button: a little larger and bolder than a normal button -->
    <style name="TextAppearance.CineFiles.Cta" parent="TextAppearance.CineFiles.Bold">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Two helpers for controls: button text (16) and chip / tab label text (14) -->
    <style name="TextAppearance.CineFiles.Button" parent="TextAppearance.CineFiles.SemiBold">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.CineFiles.Button.Compact" parent="TextAppearance.CineFiles.SemiBold">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.CineFiles.Label" parent="TextAppearance.CineFiles.Medium">
        <item name="android:textSize">14sp</item>
    </style>


    <!-- =====================================================================
         SHAPES: rounded corners from the radius tokens.
         The theme uses these for Material components; images use them through
         app:shapeAppearanceOverlay.
         ===================================================================== -->

    <style name="ShapeAppearance.CineFiles.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_small</item>
    </style>

    <style name="ShapeAppearance.CineFiles.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_medium</item>
    </style>

    <style name="ShapeAppearance.CineFiles.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_large</item>
    </style>

    <!-- A round picture (the profile photo of an actor) -->
    <style name="ShapeAppearance.CineFiles.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.CineFiles.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <!-- =====================================================================
         COMPONENTS
         Colors come from the theme: primary = the red accent, secondary container = elevated.
         ===================================================================== -->

    <!-- (Material 3 buttons are already full pills: do NOT set cornerRadius, an absolute radius makes the glow a rectangle.)
         Primary button: red pill, 52 dp tall, with a soft red glow under it (API 28+; older phones just have no glow).
         One per screen, for the main action. -->
    <style name="Widget.CineFiles.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Button</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/accent</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/accent</item>
        <item name="android:stateListAnimator">@animator/glow_press_scale</item>
    </style>

    <!-- Tonal button: a glass pill, for secondary actions -->
    <style name="Widget.CineFiles.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">@dimen/glass_stroke_width</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Compact Detail Action button (Like, Watched, Favorite) preventing word wrap -->
    <style name="Widget.CineFiles.Button.DetailAction" parent="Widget.CineFiles.Button.Tonal">
        <item name="android:minHeight">44dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Button.Compact</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- Text button: just red text, for tertiary actions -->
    <style name="Widget.CineFiles.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Button</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- Preference selection button/card: rounded glass card with press scale feedback -->
    <style name="Widget.CineFiles.Button.PreferenceCard" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">50dp</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Label</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="iconSize">@dimen/icon_size_small</item>
    </style>

    <!-- Round action button: a glass circle with an icon (undo, info, close, back...).
         Give it layout_width/height = @dimen/round_button_size, an app:icon and a contentDescription.
         Change the icon color with app:iconTint. -->
    <style name="Widget.CineFiles.RoundActionButton" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="iconSize">@dimen/icon_size</item>
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">@dimen/glass_stroke_width</item>
        <item name="iconTint">@color/text_primary</item>
        <!-- Material's icon-button style has a 4 dp left/right inset; without these two lines
             the circle would be 8 dp narrower than it is tall -->
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- (56 dp button - 24 dp icon) / 2 = 16 dp on every side, so the icon sits exactly in the middle -->
        <item name="android:paddingLeft">@dimen/space_16</item>
        <item name="android:paddingRight">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_16</item>
        <item name="android:paddingBottom">@dimen/space_16</item>
        <item name="iconPadding">0dp</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- The big version (72 dp) for the main actions, Pass and Like.
         Use layout_width/height = @dimen/round_button_large_size. (72 dp - 32 dp icon) / 2 = 20 dp padding. -->
    <style name="Widget.CineFiles.RoundActionButton.Large">
        <item name="iconSize">@dimen/icon_size_large</item>
        <item name="android:paddingLeft">@dimen/space_20</item>
        <item name="android:paddingRight">@dimen/space_20</item>
        <item name="android:paddingTop">@dimen/space_20</item>
        <item name="android:paddingBottom">@dimen/space_20</item>
    </style>

    <!-- The Like button: a solid red circle with a red glow -->
    <style name="Widget.CineFiles.RoundActionButton.Large.Like">
        <item name="backgroundTint">@color/accent</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconTint">@color/on_accent</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/accent</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/accent</item>
        <item name="android:stateListAnimator">@animator/glow_press_scale</item>
    </style>

    <!-- The Pass button: glass, with a cool slate icon -->
    <style name="Widget.CineFiles.RoundActionButton.Large.Pass">
        <item name="iconTint">@color/pass</item>
    </style>

    <!-- Selectable chip: glass pill; with a red edge and a red wash when selected -->
    <style name="Widget.CineFiles.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Label</item>
        <item name="chipStrokeWidth">@dimen/glass_stroke_width</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipStartPadding">@dimen/space_8</item>
        <item name="chipEndPadding">@dimen/space_8</item>
        <item name="textStartPadding">@dimen/space_8</item>
        <item name="textEndPadding">@dimen/space_8</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
    </style>

    <!-- A tappable name (a writer, a producer...) that opens the Person screen: the same glass pill, but it is a button, not a choice -->
    <style name="Widget.CineFiles.Chip.Person">
        <item name="android:checkable">false</item>
    </style>

    <!-- One part of a segmented control (inside a MaterialButtonToggleGroup, for example the tabs of My Collection).
         It uses the same colors as the chip: glass, and a red edge with a red wash when selected. The text shrinks
         a little if it does not fit (a long number next to "Watchlist"). -->
    <style name="Widget.CineFiles.Button.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/round_button_small_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_8</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Label</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="backgroundTint">@color/chip_background</item>
        <item name="strokeColor">@color/chip_stroke</item>
        <item name="strokeWidth">@dimen/glass_stroke_width</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <!-- A removable chip for a chosen mood (the edge color is set from code, in the mood's own color) -->
    <style name="Widget.CineFiles.Chip.Entry" parent="Widget.Material3.Chip.Input">
        <item name="chipBackgroundColor">@color/glass_fill_strong</item>
        <item name="chipStrokeColor">@color/glass_stroke</item>
        <item name="chipStrokeWidth">@dimen/glass_stroke_width</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.CineFiles.Label</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/text_secondary</item>
        <item name="closeIconSize">@dimen/icon_size_small</item>
    </style>

    <!-- Card: a quiet surface block. No border, no shadow. Change the corner with app:cardCornerRadius.
         Use it sparingly: pictures and space should carry a screen, not boxes. -->
    <style name="Widget.CineFiles.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- A glass card: a soft white wash with a light edge. Only over a picture or a glow. -->
    <style name="Widget.CineFiles.Card.Glass">
        <item name="cardBackgroundColor">@color/glass_fill</item>
        <item name="cardCornerRadius">@dimen/radius_xlarge</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">@dimen/glass_stroke_width</item>
    </style>

    <!-- Floating tab bar: a dark glass pill with a light edge. The red accent marks the active tab,
         with a soft red wash behind it. -->
    <style name="Widget.CineFiles.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:minHeight">@dimen/bottom_nav_bar_height</item>
        <!-- Our own shape (a pill with a glass edge). Material leaves a non-color background alone. -->
        <item name="android:background">@drawable/bg_glass_nav</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.CineFiles.Caption</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.CineFiles.Caption</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CineFiles.BottomNavigationIndicator</item>
        <item name="itemPaddingTop">@dimen/space_8</item>
        <item name="itemPaddingBottom">@dimen/space_8</item>
        <!-- MainActivity places the bar above the gesture bar itself -->
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingLeftSystemWindowInsets">false</item>
        <item name="paddingRightSystemWindowInsets">false</item>
    </style>

    <!-- The soft red wash behind the active tab -->
    <style name="Widget.CineFiles.BottomNavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_glow</item>
        <item name="android:height">@dimen/nav_indicator_height</item>
        <item name="android:width">@dimen/nav_indicator_width</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CineFiles.Pill</item>
    </style>

</resources>

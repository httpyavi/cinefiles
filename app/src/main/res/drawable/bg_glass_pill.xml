<?xml version="1.0" encoding="utf-8"?>
<!-- A glass pill (fully rounded): labels, counters and chips that float over a picture. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill_strong" />
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke" />
    <corners android:radius="@dimen/radius_pill" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- The big Home button: a red pill that gets a little deeper toward the bottom, with a thin light rim on the
     edge, and a light ripple when it is touched. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_stroke_bright">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/accent_deep"
                android:startColor="@color/accent"
                android:type="linear" />
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glass_stroke" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>

    <!-- The ripple stays inside the pill -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/on_accent" />
            <corners android:radius="@dimen/radius_pill" />
        </shape>
    </item>
</ripple>

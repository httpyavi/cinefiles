<?xml version="1.0" encoding="utf-8"?>
<!-- Soft scrim for the TOP of an image, so a header sitting on the picture stays readable.
     Dark at the top, fully clear at the bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="@color/scrim_mid"
        android:startColor="@color/scrim_clear"
        android:type="linear" />
</shape>

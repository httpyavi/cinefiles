<?xml version="1.0" encoding="utf-8"?>
<!-- The small rounded badge that stands for TMDB in the credit on the Profile screen (TMDB's green to blue). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/tmdb_blue"
        android:startColor="@color/tmdb_green" />
    <corners android:radius="@dimen/radius_small" />
</shape>

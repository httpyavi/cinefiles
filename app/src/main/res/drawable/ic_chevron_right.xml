<?xml version="1.0" encoding="utf-8"?>
<!-- A small arrow pointing right: "this opens something" (the movie's name on a diary page). 24 dp icon. Colored by the theme unless a view sets its own tint. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="@dimen/icon_size"
    android:height="@dimen/icon_size"
    android:autoMirrored="true"
    android:tint="?attr/colorControlNormal"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:strokeColor="@color/text_primary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M9,5 L16,12 L9,19" />
</vector>

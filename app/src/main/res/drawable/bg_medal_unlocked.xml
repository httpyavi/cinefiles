<?xml version="1.0" encoding="utf-8"?>
<!-- A badge that has been earned: a round red plate that gets lighter toward the top-left, like a lit medal. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:endColor="@color/accent_deep"
        android:startColor="@color/accent_soft"
        android:type="linear" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- A hair-thin light edge around a swipe card. It makes the card look like a sheet of glass lying on the dark. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke_bright" />
    <corners android:radius="@dimen/radius_xlarge" />
</shape>

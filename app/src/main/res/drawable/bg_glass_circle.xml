<?xml version="1.0" encoding="utf-8"?>
<!-- A round glass plate, for icon buttons that float over a picture (close, back, search). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/glass_fill_strong" />
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke" />
</shape>

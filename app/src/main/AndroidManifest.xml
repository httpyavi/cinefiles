<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to talk to TMDB -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CineFilesApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CineFiles"
        tools:targetApi="31">

        <!-- The only activity. The app is portrait only ON PURPOSE: the swipe deck, the mood slider and the tall poster
             layouts are designed for a tall screen (so lint's "locked orientation" warning is switched off here).
             The "Starting" theme shows the splash screen. adjustResize makes the keyboard report its height as a window inset;
             applySystemBarsPadding (util/ViewExtensions.kt) lifts the bars at the bottom of a screen above it, so the
             Diary editor's formatting strip and the search field are never hidden behind the keyboard. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"
            android:theme="@style/Theme.CineFiles.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
